<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="Purge Domain: offline training subgroup demonstration" description="End-to-end teaching pipeline. Follow the numbered stages and the implementation guide. EDA/preview branches are separate from validation; preprocessing is fitted inside learner training.">
  <nodes>
    <node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="" version="" title="File - bundled heart data" position="(90, 150)" />
